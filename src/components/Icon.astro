---
/**
 * Inline SVG icon set. Deliberately small — icons appear only where they aid
 * comprehension, never as decoration. Inlining avoids an icon-font request and
 * lets icons inherit `currentColor`.
 *
 * All icons are 24x24 on a 2px stroke grid so they optically match at any size.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
  /** Set when the icon carries meaning on its own; otherwise it stays hidden. */
  title?: string;
}

const PATHS = {
  gauge: '<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="m14.1 9.9 3.4-3.4"/><path d="M3.3 19a10 10 0 1 1 17.4 0"/>',
  activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  'trending-up': '<path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/>',
  accessibility:
    '<circle cx="12" cy="4" r="2"/><path d="M19 8.5 14 10v4l2.5 6"/><path d="M5 8.5 10 10v4l-2.5 6"/><path d="M10 10h4"/>',
  radar: '<path d="M19.07 4.93A10 10 0 1 1 4.93 19.07"/><path d="M15.5 8.5A5 5 0 1 0 8.5 15.5"/><path d="M12 12 8.5 15.5"/><path d="M4 12H2"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.7 8.9a1.9 1.9 0 0 1-1.3 0C6.8 20.5 3.3 18 3.3 13V6a2 2 0 0 1 2-2c2 0 4.5-1.2 6.2-2.7a1.9 1.9 0 0 1 2.4 0C15.6 2.8 18.1 4 20 4a2 2 0 0 1 2 2Z" transform="translate(-1)"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.9 1.9 0 0 1-2.06 0L2 7"/>',
  alert: '<path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>',
  'message-circle': '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  spinner: '<path d="M21 12a9 9 0 1 1-6.22-8.56"/>',
} as const;

const { name, size = 20, class: className = '', title } = Astro.props;
const path = PATHS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  set:html={path}
/>
