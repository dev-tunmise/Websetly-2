---
import { Image } from 'astro:assets';
import logoMark from '../assets/site/logo.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-semibold tracking-tight text-ink-900',
    className,
  ]}
>
  <Image
    src={logoMark}
    alt=""
    width={96}
    loading="eager"
    class="h-[1.6em] w-auto"
  />
  <span>Websetly</span>
</span>