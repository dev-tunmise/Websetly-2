---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-semibold tracking-tight text-ink-900',
    className,
  ]}
>
  <svg
    width="1.5em"
    height="1.5em"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
  >
    <rect width="32" height="32" rx="8" fill="#2e7d59"></rect>
    <path
      d="M7.5 11 12.5 21.5 16 14.5 19.5 21.5 24.5 11"
      stroke="#ffffff"
      stroke-width="2.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span>Websetly</span>
</span>