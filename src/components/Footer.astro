---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../consts';

const year = new Date().getFullYear();

const footerServices = [
  { label: 'Website Development', href: '/services/website-development' },
  { label: 'Shopify Store Design', href: '/services/shopify-store-design' },
  { label: 'Website Redesign', href: '/services/website-redesign' },
  { label: 'Speed & Performance', href: '/services/website-performance-optimization' },
  { label: 'SEO', href: '/services/technical-seo' },
  { label: 'Website Maintenance', href: '/services/website-maintenance' },
];

const quickLinks = [
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const contactInfo = [
  {
    icon: 'mail',
    label: 'Email',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
  },
  {
    icon: 'message-circle',
    label: 'WhatsApp',
    value: SITE.phone,
    href: `https://wa.me/${SITE.whatsapp}`,
    external: true,
  },
];

const resources = [
  { label: 'Free Site Analysis', href: '/analyze' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
];
---

<footer class="border-t border-ink-200 bg-ink-50">
  <div class="container-page py-14 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:flex lg:justify-between lg:gap-8">
      <div class="lg:max-w-[15rem]">
        <a href="/" class="no-underline" aria-label="Websetly — home">
          <Logo class="text-lg" />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-600">
          We build, redesign and optimize websites for businesses, startups and
          online stores.
        </p>
        
      </div>

      <nav aria-labelledby="ft-services">
        <h2 id="ft-services" class="text-sm font-semibold text-ink-900">Services</h2>
        <ul class="mt-4 space-y-2.5">
          {
            footerServices.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="text-sm text-ink-600 no-underline hover:text-brand-700 hover:underline"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="ft-quick">
        <h2 id="ft-quick" class="text-sm font-semibold text-ink-900">Quick Links</h2>
        <ul class="mt-4 space-y-2.5">
          {
            quickLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-ink-600 no-underline hover:text-brand-700 hover:underline"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="ft-resources">
        <h2 id="ft-resources" class="text-sm font-semibold text-ink-900">Resources</h2>
        <ul class="mt-4 space-y-2.5">
          {
            resources.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-ink-600 no-underline hover:text-brand-700 hover:underline"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:shrink-0">
        <h2 class="text-sm font-semibold text-ink-900">Contact Info</h2>
        <ul class="mt-4 space-y-3">
          {
            contactInfo.map((c) => (
              <li class="flex gap-2.5">
                <Icon
                  name={c.icon as any}
                  size={16}
                  class="mt-0.5 shrink-0 text-brand-600"
                />
                <div>
                  <span class="block text-xs text-ink-500">{c.label}</span>
                  <a
                    href={c.href}
                    rel={c.external ? 'noopener' : undefined}
                    class="text-sm text-ink-700 no-underline hover:text-brand-700 hover:underline"
                  >
                    {c.value}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="rule mt-12" />

    <div
      class="mt-6 flex flex-col-reverse items-start justify-between gap-4 sm:flex-row sm:items-center"
    >
      <p class="text-sm text-ink-500">
        &copy; {year} {SITE.name}. All rights reserved.
      </p>
      <p class="text-sm text-ink-500">Web Design, Development &amp; Optimization</p>
    </div>
  </div>
</footer>