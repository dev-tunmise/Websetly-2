---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../consts';

const year = new Date().getFullYear();

const services = [
  { label: 'Website Development', href: '/services/website-development' },
  { label: 'Website Redesign', href: '/services/website-redesign' },
  { label: 'Speed & Performance', href: '/services/website-performance-optimization' },
  { label: 'SEO', href: '/services/technical-seo' },
];

const company = [
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
  { label: 'Free Site Analysis', href: '/analyze' },
];

const linkClass =
  'text-sm text-ink-600 no-underline hover:text-brand-700 hover:underline';
---

<footer class="border-t border-ink-200 bg-ink-50">
  <div class="container-page py-12 sm:py-14">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:flex lg:justify-between lg:gap-8">
      <div class="col-span-2 lg:max-w-[18rem]">
        <a href="/" class="no-underline" aria-label="Websetly — home">
          <Logo class="text-lg" />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-600">
          We build, redesign and optimize websites for businesses, startups and
          online stores.
        </p>
      </div>

      <nav aria-labelledby="ft-services">
        <h2 id="ft-services" class="text-sm font-semibold text-ink-900">Services</h2>
        <ul class="mt-4 space-y-2.5">
          {
            services.map((s) => (
              <li><a href={s.href} class={linkClass}>{s.label}</a></li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="ft-company">
        <h2 id="ft-company" class="text-sm font-semibold text-ink-900">Company</h2>
        <ul class="mt-4 space-y-2.5">
          {
            company.map((l) => (
              <li><a href={l.href} class={linkClass}>{l.label}</a></li>
            ))
          }
        </ul>
      </nav>

      <div class="col-span-2 lg:col-span-1">
        <h2 class="text-sm font-semibold text-ink-900">Contact</h2>
        <ul class="mt-4 space-y-3">
          <li class="flex items-center gap-2.5">
            <Icon name="mail" size={16} class="shrink-0 text-brand-600" />
            <a href={`mailto:${SITE.email}`} class={linkClass}>{SITE.email}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="message-circle" size={16} class="shrink-0 text-brand-600" />
            <a
              href={`https://wa.me/${SITE.whatsapp}`}
              rel="noopener"
              class={linkClass}
            >
              WhatsApp: {SITE.phone}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="rule mt-10" />

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-ink-500">
        &copy; {year} {SITE.name}. All rights reserved.
      </p>
      <p class="flex gap-5 text-sm">
        <a href="/privacy" class={linkClass}>Privacy Policy</a>
        <a href="/terms" class={linkClass}>Terms of Service</a>
      </p>
    </div>
  </div>
</footer>