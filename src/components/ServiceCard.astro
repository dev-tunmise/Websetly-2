---
import Icon from './Icon.astro';
import type { Service } from '../consts';

interface Props {
  service: Service;
  /* Cards under a section heading are h3. Use h2 only if the cards are the
     page's top-level content. */
  as?: 'h2' | 'h3';
}

const { service, as: Heading = 'h3' }: Props = Astro.props;
const href = `/services/${service.slug}`;
---

<article class="card card-interactive reveal group relative flex flex-col">
  <Heading class="text-lg">
    <a
      href={href}
      class="text-ink-900 no-underline transition-colors group-hover:text-brand-700 after:absolute after:inset-0 after:content-['']"
    >
      {service.title}
    </a>
  </Heading>

  <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
    {service.summary}
  </p>

  <Icon
    name="arrow-right"
    size={16}
    class="pointer-events-none absolute right-4 bottom-3 text-ink-400 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-700"
  />
</article>