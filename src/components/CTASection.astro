---
import AnalyzerForm from './AnalyzerForm.astro';

/**
 * The closing conversion block. Used at the foot of the homepage and every
 * service page so the single primary action is always the last thing a visitor
 * sees, regardless of entry point.
 */
interface Props {
  title?: string;
  /** Swap the form for a plain pair of buttons on pages where a URL field
      would be redundant (e.g. the analyzer page itself). */
  variant?: 'form' | 'buttons';
  source?: string;
}

const {
  title = 'See what is slowing your site down',
  variant = 'form',
  source = 'closing-cta',
} = Astro.props;
---

<section class="section">
  <div class="container-page">
    <!-- One solid brand green, no gradient and no border. brand-800 is dark
         enough that white body copy clears AA comfortably, which a lighter
         green would not. -->
    <div class="rounded-2xl bg-brand-800 px-6 py-14 sm:px-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl text-white sm:text-4xl">{title}</h2>

        <div class="mt-8">
          {
            variant === 'form' ? (
              <div class="mx-auto max-w-xl">
                <AnalyzerForm
                  id="cta-analyzer"
                  size="lg"
                  source={source}
                  tone="onDark"
                  align="center"
                />
              </div>
            ) : (
              <div class="flex flex-col justify-center gap-3 sm:flex-row">
                <a href="/contact" class="btn btn-secondary btn-lg">
                  Book a free audit call
                </a>
                <a
                  href="/services"
                  class="btn btn-lg border-brand-400 text-white hover:bg-brand-700"
                >
                  See what we can do
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
