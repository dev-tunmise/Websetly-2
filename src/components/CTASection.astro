---
/**
 * Closing call to action. Used at the foot of the service pages and other
 * pages that import it.
 */
interface Props {
  title?: string;
  description?: string;
  /** Kept so existing pages that pass these props do not break. */
  variant?: 'form' | 'buttons';
  source?: string;
}

const {
  title = 'Ready to build or improve your website?',
  description = 'Tell us what you need. Let’s talk about how we can help.',
} = Astro.props;
---

<section class="section">
  <div class="container-page">
    <div class="rounded-2xl bg-brand-900 px-6 py-14 text-center sm:px-12">
      <h2 class="text-3xl text-white">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-brand-100">{description}</p>
      <div class="mt-8">
        <a href="/contact" class="btn btn-secondary btn-lg">Contact Us</a>
      </div>
    </div>
  </div>
</section>