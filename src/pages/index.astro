---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import AnalyzerForm from '../components/AnalyzerForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PostCard from '../components/PostCard.astro';
import CTASection from '../components/CTASection.astro';
import HeroVisual from '../components/HeroVisual.astro';
import Icon from '../components/Icon.astro';
import { PRIMARY_SERVICES, SITE } from '../consts';
import { PROBLEMS, PROCESS, TRUST_STATS } from '../data/homepage';
import { TESTIMONIALS } from '../data/testimonials';
import { getPublishedPosts } from '../lib/blog';

const posts = (await getPublishedPosts()).slice(0, 3);

/* The case-studies section is temporarily removed along with the /portfolio
   hub it linked into — see src/pages/_portfolio.astro. The content collection
   itself is untouched, so restoring this is a matter of putting the query and
   the section back. */

const title = 'Website Performance & Growth Agency';
const description =
  'We improve Core Web Vitals, technical SEO and conversion rates for businesses and e-commerce stores. Get a free performance report in 30 seconds.';

/**
 * FAQPage schema drawn from the questions the legacy site already ranked for,
 * rewritten for the new positioning. This is the homepage's best shot at a
 * rich result.
 */
const faqs = [
  {
    q: 'How quickly will I see results?',
    a: 'Lab improvements are visible immediately after we ship a fix. Core Web Vitals in Search Console are assessed on a rolling 28-day window of real user data, so field improvements typically surface there within four to six weeks.',
  },
  {
    q: 'Do you work with Shopify and WordPress?',
    a: 'Yes. Most of our work is on existing Shopify, WooCommerce, WordPress and custom stacks. We do not require you to replatform — the entire point is to fix what you already have.',
  },
  {
    q: 'What does the free report include?',
    a: 'Your Core Web Vitals from real Chrome user data where available, Lighthouse scores for performance, accessibility, best practices and SEO, and the specific opportunities ranked by the load time each one would save.',
  },
  {
    q: 'Do you still build new websites?',
    a: 'Yes, as a secondary service. If an audit concludes the platform itself is the constraint, we build a replacement engineered for Core Web Vitals and accessibility from the first commit, with a full redirect map so no rankings are lost.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`${title} | ${SITE.name}`}
  description={description}
  schemaEntities={[faqSchema]}
>
  <!-- ================================================== 1. HERO + ANALYZER -->
  <section class="relative overflow-hidden border-b border-ink-200">
    <!-- A single soft wash, not a heavy gradient. It gives the hero depth
         without competing with the form. -->
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-b from-brand-50/60 via-white to-white"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative pt-14 pb-16 sm:pt-20 sm:pb-24">
      <div
        class="grid items-center gap-16 lg:grid-cols-[minmax(0,1fr)_26rem]"
      >
        <div class="max-w-3xl">
          <p class="eyebrow mb-4">Website Performance &amp; Growth</p>
          <h1 class="text-5xl">
            Faster websites. Better rankings.<br class="hidden sm:block" />
            <span class="text-brand-700">More revenue.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-xl leading-relaxed text-ink-600">
            We find what is slowing your website down, then fix it. Start with a
            free report.
          </p>

          <div class="mt-9 max-w-xl">
            <AnalyzerForm size="lg" source="homepage-hero" />
          </div>
        </div>

        <!-- Desktop only. On mobile it would push the form below the fold to
             restate a promise the headline has already made. -->
        <HeroVisual class="hidden lg:block" />
      </div>
    </div>
  </section>

  <!-- ============================================== 2. TRUST INDICATORS -->
  <section class="border-b border-ink-200 bg-white">
    <div class="container-page py-8 sm:py-10">
      <dl class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4 sm:gap-8">
        {
          TRUST_STATS.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-2xl font-semibold text-brand-600 sm:text-3xl">
                  {s.value}
                </span>
                <span class="mt-1 block text-sm text-ink-500">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ========================================== 3. PROBLEMS WE SOLVE -->
  <Section
    eyebrow="What we fix"
    title="The problems costing you customers"
    tone="muted"
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROBLEMS.map((p) => (
          <div class="card reveal bg-white">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-lg bg-sky-50 text-sky-700"
              aria-hidden="true"
            >
              <Icon name={p.icon as any} size={20} />
            </span>
            <h3 class="mt-5 text-lg">{p.title}</h3>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
              {p.body}
            </p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ==================================================== 4. SERVICES -->
  <Section
    eyebrow="Services"
    title="What we do"
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {PRIMARY_SERVICES.map((s) => <ServiceCard service={s} />)}
    </div>
  </Section>

  <!-- ===================================================== 5. PROCESS -->
  <Section
    eyebrow="How it works"
    title="Measure, diagnose, fix, monitor"
    tone="muted"
  >
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        PROCESS.map((p) => (
          <li class="card reveal bg-white">
            <span class="font-mono text-sm font-semibold text-brand-600">
              {p.step}
            </span>
            <h3 class="mt-4 text-lg">{p.title}</h3>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
              {p.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ================================================ 8. TESTIMONIALS -->
  {
    TESTIMONIALS.length > 0 && (
      <Section eyebrow="In their words" title="What clients say">
        <div class="grid gap-5 lg:grid-cols-3">
          {TESTIMONIALS.slice(0, 3).map((t) => (
            <figure class="card reveal flex flex-col">
              <blockquote class="flex-1 text-[0.9375rem] leading-relaxed text-ink-700">
                {t.quote}
              </blockquote>
              <figcaption class="mt-6 border-t border-ink-200 pt-5">
                <span class="block font-medium text-ink-900">{t.name}</span>
                <span class="block text-sm text-ink-500">
                  {t.role}, {t.company}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </Section>
    )
  }

  <!-- ============================================== 9. BLOG PREVIEWS -->
  {
    posts.length > 0 && (
      <Section eyebrow="Blog" title="Latest articles">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((p, i) => (
            <PostCard post={p} eager={i === 0} />
          ))}
        </div>
        <div class="mt-8">
          <a href="/blog" class="btn btn-secondary">Read the blog</a>
        </div>
      </Section>
    )
  }

  <!-- FAQ. Rendered visibly as well as in schema — Google devalues structured
       data that has no on-page equivalent. -->
  <Section title="Common questions" tone="muted" align="center">
    <!-- Centred on the same measure as the heading above it, so the header and
         the list share one axis instead of the header centring over a
         left-aligned column. -->
    <div class="mx-auto max-w-2xl">
      {
        faqs.map((f) => (
          <details class="group border-b border-ink-200 first:border-t">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-lg font-medium text-ink-900 marker:content-none hover:text-brand-700 [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              {/* Nudged onto the cap height of the first line so it sits level
                  with the question rather than with the flex box. */}
              <Icon
                name="chevron-down"
                size={20}
                class="mt-1 shrink-0 text-ink-400 transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="pb-5 text-left leading-relaxed text-ink-600">{f.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <!-- ================================================= 10. FINAL CTA -->
  <CTASection source="homepage-closing" />
</BaseLayout>
