---
import PageLayout from '../layouts/PageLayout.astro';
import BlogList from '../components/BlogList.astro';
import CTASection from '../components/CTASection.astro';
import { getPublishedPosts, postUrl, POSTS_PER_PAGE } from '../lib/blog';
import { SITE } from '../consts';

/**
 * Blog hub, page 1. URL preserved (/blog).
 *
 * Pages 2+ live at /blog/page/N — see src/pages/blog/page/[page].astro. They are
 * a separate route rather than a rest parameter on this one so they can never
 * collide with /blog/:slug, and so /blog itself stays a plain static file.
 *
 * Note this page was NOT in the legacy sitemap.xml even though it was linked
 * from every page's navigation and had 15 posts hanging off it — one of the
 * bigger technical SEO defects found in the audit. It is now generated into the
 * sitemap automatically along with every post.
 */
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));

const title = 'Website Performance & SEO Blog';
const description =
  'Practical guides on making websites faster: Core Web Vitals, page speed, technical SEO, accessibility and conversion — written for people who have to ship the fix.';

/* Schema lists the whole archive, not just this page — it describes the blog,
   which does not change as you page through it. */
const blogSchema = {
  '@type': 'Blog',
  '@id': `${SITE.url}/blog#blog`,
  name: `${SITE.name} Blog`,
  description,
  url: `${SITE.url}/blog`,
  publisher: { '@id': `${SITE.url}/#organization` },
  blogPost: allPosts.slice(0, 20).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(postUrl(p), SITE.url).href,
    datePublished: p.data.pubDate.toISOString(),
    description: p.data.description,
  })),
};
---

<PageLayout
  title={title}
  description={description}
  heading="Latest articles"
  lede="Guides on website performance, SEO, accessibility, and growth."
  breadcrumbs={[{ name: 'Blog', href: '/blog' }]}
  schemaEntities={[blogSchema]}
>
  <BlogList posts={posts} allPosts={allPosts} page={1} totalPages={totalPages} />

  <CTASection source="blog-closing" />
</PageLayout>
