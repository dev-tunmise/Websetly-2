---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../consts';

/**
 * Case studies hub.
 *
 * URL preserved as /portfolio — it is in the live sitemap and indexed. The
 * label and content reposition to "case studies" while the path stays put;
 * /case-studies is redirected here in public/_redirects for the nicer slug.
 */
const studies = (
  await getCollection('caseStudies', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'Case Studies & Client Work';
const description =
  'Websites we have built and improved, and what changed as a result — across SaaS, education, real estate and hospitality.';

const listSchema = {
  '@type': 'ItemList',
  '@id': `${SITE.url}/portfolio#list`,
  itemListElement: studies.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.title,
    url: `${SITE.url}/portfolio/${s.id}`,
  })),
};
---

<PageLayout
  title={title}
  description={description}
  heading="Case studies"
  lede="What we changed, and what changed as a result."
  eyebrow="Our work"
  breadcrumbs={[{ name: 'Case Studies', href: '/portfolio' }]}
  schemaEntities={[listSchema]}
>
  <div class="container-page py-12 sm:py-16">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        studies.map((cs, i) => (
          <article class="card card-interactive relative flex flex-col overflow-hidden p-0">
            {cs.data.heroImage && (
              <Image
                src={cs.data.heroImage}
                alt={cs.data.heroImageAlt ?? ''}
                widths={[600, 1000]}
                sizes="(min-width: 1024px) 560px, 100vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                class="aspect-[16/9] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-7">
              <div class="flex flex-wrap items-center gap-2">
                <span class="pill pill-sky">{cs.data.industry}</span>
                <span class="pill">{cs.data.client}</span>
              </div>

              <h2 class="mt-4 text-xl leading-snug">
                <a
                  href={`/portfolio/${cs.id}`}
                  class="text-ink-900 no-underline after:absolute after:inset-0 after:content-['']"
                >
                  {cs.data.title}
                </a>
              </h2>

              <p class="mt-3 leading-relaxed text-ink-600">{cs.data.description}</p>

              {cs.data.metrics.length > 0 && (
                <dl class="mt-6 grid grid-cols-2 gap-5 border-t border-ink-200 pt-5">
                  {cs.data.metrics.map((m) => (
                    <div>
                      <dt class="text-xs text-ink-500">{m.label}</dt>
                      <dd class="mt-1 text-lg font-semibold text-brand-700">
                        {m.after}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <CTASection source="portfolio-closing" />
</PageLayout>
