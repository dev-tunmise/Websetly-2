---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE, SERVICES } from '../../consts';

export const getStaticPaths = (async () => {
  const studies = await getCollection('caseStudies', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}) satisfies GetStaticPaths;

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const { data } = study;
const { Content } = await render(study);

const url = `${SITE.url}/portfolio/${study.id}`;

const schema = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  about: { '@type': 'Organization', name: data.client },
  ...(data.heroImage ? { image: new URL(data.heroImage.src, SITE.url).href } : {}),
};

// Link the named services back to their pages — a case study that mentions a
// service without linking to it wastes the internal link.
const linkedServices = data.services
  .map((name) => SERVICES.find((s) => s.title === name))
  .filter((s): s is (typeof SERVICES)[number] => Boolean(s));
---

<PageLayout
  title={`${data.client} Case Study`}
  description={data.description}
  heading={data.title}
  lede={data.description}
  eyebrow={`${data.client} · ${data.industry}`}
  breadcrumbs={[
    { name: 'Case Studies', href: '/portfolio' },
    { name: data.client, href: `/portfolio/${study.id}` },
  ]}
  schemaEntities={[schema]}
>
  {
    data.metrics.length > 0 && (
      <Fragment slot="hero-extra">
        <dl class="mt-8 flex flex-wrap gap-x-12 gap-y-5">
          {data.metrics.map((m) => (
            <div>
              <dt class="text-sm text-ink-500">{m.label}</dt>
              <dd class="mt-1 text-2xl font-semibold text-brand-700">{m.after}</dd>
            </div>
          ))}
        </dl>
      </Fragment>
    )
  }

  {
    data.heroImage && (
      <div class="container-page pt-12">
        <Image
          src={data.heroImage}
          alt={data.heroImageAlt ?? ''}
          widths={[720, 1120]}
          sizes="(min-width: 1024px) 1120px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="rounded-xl border border-ink-200"
        />
      </div>
    )
  }

  <div class="container-page py-12 sm:py-16">
    <div class="container-prose mx-0 case-body">
      <Content />
    </div>

    {
      linkedServices.length > 0 && (
        <div class="container-prose mx-0 mt-12 border-t border-ink-200 pt-8">
          <h2 class="text-lg">Services used</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {linkedServices.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="pill pill-brand no-underline">
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <CTASection source={`case-study-${study.id}`} />
</PageLayout>

<style>
  .case-body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .case-body :global(h2:first-child) {
    margin-top: 0;
  }
  .case-body :global(p) {
    margin-bottom: 1.25rem;
    font-size: var(--text-lg);
    line-height: 1.75;
  }
  .case-body :global(ul) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    list-style: disc;
    font-size: var(--text-lg);
    line-height: 1.75;
  }
  .case-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .case-body :global(li)::marker {
    color: var(--color-brand-400);
  }
  .case-body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-ink-300);
    background: var(--color-ink-50);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-ink-600);
    font-size: var(--text-base);
  }
  .case-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
</style>
