---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { SERVICES, SITE } from '../consts';

const title = 'Website Design, Development & Optimization Services';
const description =
  'Websetly builds business websites, online stores and Shopify and WordPress sites. We also redesign, speed up and maintain existing websites.';

/* Cards without an href are not links, because they have no page yet. */
const buildServices = [
  {
    title: 'Business Websites',
    body: 'A clear, professional website for your business. It shows what you do, builds trust and makes it easy for customers to contact you. It works well on phones, tablets and computers.',
    href: '/services/website-development',
  },
  {
    title: 'Online Stores',
    body: 'An online store where customers can browse your products and place orders easily. We set it up so buying is simple and your products are easy to find.',
    href: '/services/online-stores',
  },
  {
    title: 'Shopify Stores',
    body: 'A Shopify store set up and designed to match your brand. We arrange your products, pages and layout so customers can shop with ease.',
    href: '/services/shopify-store-design',
  },
  {
    title: 'WordPress Websites',
    body: 'A WordPress website that you can update and manage yourself. You can change text, add pages and post news without needing a developer every time.',
    href: '/services/wordpress-websites',
    },
];

const improveServices = [
  {
    title: 'Website Redesign',
    body: 'Is your website old or hard to use? We give it a fresh look and a cleaner layout. We keep what already works and improve what does not, so visitors find things faster.',
    href: '/services/website-redesign',
  },
  {
    title: 'Speed & Performance',
    body: 'A slow website makes visitors leave. We find what slows your pages down and fix it, so your site opens faster and feels smoother on phones and computers.',
    href: '/services/website-performance-optimization',
  },
  {
    title: 'SEO',
    body: 'If people cannot find your site on Google, they cannot become customers. We make changes that help Google understand your pages, so your site can show up when people search for what you offer.',
    href: '/services/technical-seo',
  },
  {
    title: 'Website Maintenance',
    body: 'Websites need regular care. We keep yours updated, backed up and checked, so it stays safe and keeps working without you having to worry about it.',
    href: '/services/website-maintenance',
  },
];

const serviceSchema = SERVICES.map((s) => ({
  '@type': 'Service',
  '@id': `${SITE.url}/services/${s.slug}#service`,
  name: s.title,
  description: s.summary,
  url: `${SITE.url}/services/${s.slug}`,
  provider: { '@id': `${SITE.url}/#organization` },
  serviceType: s.title,
}));
---

<PageLayout
  title={title}
  description={description}
  heading="Our Services"
  lede="We build new websites and improve existing ones."
  breadcrumbs={[{ name: 'Services', href: '/services' }]}
  schemaEntities={serviceSchema}
>
  <!-- ===================================== 1. WEBSITE DEVELOPMENT -->
  <span id="web-design" class="block scroll-mt-28"></span>
  <span id="development" class="block scroll-mt-28"></span>
  <Section eyebrow="Build" title="Website Development">
    <p class="max-w-2xl text-lg leading-relaxed text-ink-600">
      We design and build new websites for businesses, professionals and online
      stores.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        buildServices.map((s) => {
          const Tag = s.href ? 'a' : 'div';
          return (
            <Tag
              href={s.href}
              class:list={[
                'card reveal group relative flex flex-col',
                s.href && 'card-interactive',
              ]}
            >
              <h3 class="text-lg">{s.title}</h3>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
                {s.body}
              </p>
              {s.href && (
                <Icon
                  name="arrow-right"
                  size={16}
                  class="absolute right-4 bottom-3 text-ink-400 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-700"
                />
              )}
            </Tag>
          );
        })
      }
    </div>
    <div class="mt-10">
      <a href="/contact" class="btn btn-primary btn-lg">Contact Us</a>
    </div>
  </Section>

  <!-- ===================================== 2. WEBSITE OPTIMIZATION -->
  <span id="seo-setup" class="block scroll-mt-28"></span>
  <Section eyebrow="Improve" title="Website Optimization" tone="muted">
    <p class="max-w-2xl text-lg leading-relaxed text-ink-600">
      We improve websites that are slow, outdated or hard to find.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        improveServices.map((s) => (
          <a
            href={s.href}
            class="card card-interactive reveal group relative flex flex-col"
          >
            <h3 class="text-lg">{s.title}</h3>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
              {s.body}
            </p>
            <Icon
              name="arrow-right"
              size={16}
              class="absolute right-4 bottom-3 text-ink-400 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-700"
            />
          </a>
        ))
      }
    </div>
    <div class="mt-10">
      <a href="/analyze" class="btn btn-primary btn-lg">Analyze Your Site</a>
    </div>
  </Section>
</PageLayout>