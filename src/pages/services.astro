---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES, SITE, getService } from '../consts';

const title = 'Website Design, Development & Optimization Services';
const description =
  'Websetly builds business websites, online stores and Shopify and WordPress sites. We also redesign, speed up and maintain existing websites.';

/* Which services appear in each row, in order. The text for each card lives
   in src/consts.ts, so change wording there, not here. */
const pick = (slugs: string[]) => slugs.map((s) => getService(s)!);

const buildServices = pick([
  'website-development',
  'online-stores',
  'shopify-store-design',
  'wordpress-websites',
]);

const improveServices = pick([
  'website-redesign',
  'website-performance-optimization',
  'technical-seo',
  'website-maintenance',
]);

const serviceSchema = SERVICES.map((s) => ({
  '@type': 'Service',
  '@id': `${SITE.url}/services/${s.slug}#service`,
  name: s.title,
  description: s.metaDescription,
  url: `${SITE.url}/services/${s.slug}`,
  provider: { '@id': `${SITE.url}/#organization` },
  serviceType: s.title,
}));
---

<PageLayout
  title={title}
  description={description}
  heading="Our Services"
  lede="We build new websites and improve existing ones."
  breadcrumbs={[{ name: 'Services', href: '/services' }]}
  schemaEntities={serviceSchema}
>
  <!-- ===================================== 1. WEBSITE DEVELOPMENT -->
  <span id="web-design" class="block scroll-mt-28"></span>
  <span id="development" class="block scroll-mt-28"></span>
  <Section eyebrow="Build" title="Website Development">
    <p class="max-w-2xl text-lg leading-relaxed text-ink-600">
      We design and build new websites for businesses, professionals and online
      stores.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {buildServices.map((s) => <ServiceCard service={s} />)}
    </div>
    <div class="mt-10">
      <a href="/contact" class="btn btn-primary btn-lg">Contact Us</a>
    </div>
  </Section>

  <!-- ===================================== 2. WEBSITE OPTIMIZATION -->
  <span id="seo-setup" class="block scroll-mt-28"></span>
  <Section eyebrow="Improve" title="Website Optimization" tone="muted">
    <p class="max-w-2xl text-lg leading-relaxed text-ink-600">
      We improve websites that are slow, outdated or hard to find.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {improveServices.map((s) => <ServiceCard service={s} />)}
    </div>
    <div class="mt-10">
      <a href="/analyze" class="btn btn-primary btn-lg">Analyze Your Site</a>
    </div>
  </Section>
</PageLayout>