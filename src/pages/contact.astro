---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';

const title = 'Contact Websetly';
const description =
  'Tell us what you need. Whether it is a new website, a redesign or improvements to your current site, we will get back to you.';

const contactSchema = {
  '@type': 'ContactPage',
  '@id': `${SITE.url}/contact#page`,
  url: `${SITE.url}/contact`,
  about: { '@id': `${SITE.url}/#organization` },
};

const serviceOptions = [
  'New website',
  'Online store (Shopify or other)',
  'WordPress website',
  'Website redesign',
  'Speed and performance',
  'SEO',
  'Website maintenance',
];
---

<PageLayout
  title={title}
  description={description}
  heading="Get in touch"
  lede="Tell us what you need and we'll get back to you."
  breadcrumbs={[{ name: 'Contact', href: '/contact' }]}
  schemaEntities={[contactSchema]}
>
  <div class="container-page py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <!-- ------------------------------------------------------- form -->
      <div class="lg:col-span-3">
        <div
          id="analyzer-note"
          hidden
          class="card mb-8 border-brand-200 bg-brand-50"
        >
          <p class="font-medium text-ink-900">Your report is ready.</p>
          <p class="mt-1.5 text-[0.9375rem] text-ink-600">
            Send us a message and we'll tell you what we would fix first.
          </p>
        </div>

        <!-- Shown after a successful send. Replaces the form. -->
        <div
          id="form-success"
          hidden
          role="status"
          class="card border-brand-200 bg-brand-50"
        >
          <h2 class="text-xl">Thank you. Your message has been sent.</h2>
          <p class="mt-2.5 text-ink-600">
            We'll read it and get back to you as soon as possible.
          </p>
          <a href="/" class="btn btn-secondary mt-6">Back to home</a>
        </div>

        <form
          action={SITE.formspree}
          method="POST"
          class="space-y-5"
          id="contact-form"
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="label">Your name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="field"
              />
            </div>
            <div>
              <label for="email" class="label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="field"
              />
            </div>
          </div>

          <div>
            <label for="website" class="label">
              Your website <span class="font-normal text-ink-500">(if you have one)</span>
            </label>
            <input
              type="url"
              id="website"
              name="website"
              inputmode="url"
              autocomplete="url"
              placeholder="yourwebsite.com"
              class="field"
            />
          </div>

          <div>
            <label for="service" class="label">
              What do you need? <span class="font-normal text-ink-500">(optional)</span>
            </label>
            <select id="service" name="service" class="field">
              <option value="">Not sure yet</option>
              {serviceOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div>
            <label for="message" class="label">Tell us about your project</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="field resize-y"
              placeholder="For example: I need a website for my business, or I want to improve my current site."></textarea>
          </div>

          <!-- Honeypot. Bots fill it; people never see it. -->
          <div class="hidden" aria-hidden="true">
            <label for="company-website">Leave this empty</label>
            <input type="text" id="company-website" name="_gotcha" tabindex="-1" />
          </div>

          <input
            type="hidden"
            name="_subject"
            value="New enquiry from websetly.com"
          />
          <input
            type="hidden"
            name="source"
            id="lead-source"
            value="contact-page"
          />

          <p id="form-error" hidden role="alert" class="text-sm font-medium text-bad">
            Sorry, your message was not sent. Please try again, or email or
            WhatsApp us using the details on this page.
          </p>

          <button
            type="submit"
            id="submit-btn"
            class="btn btn-primary btn-lg w-full sm:w-auto"
          >
            Send message
          </button>

          <p class="text-sm text-ink-500">
            We’ll review your message and get back to you as soon as
            possible.
          </p>
        </form>
      </div>

      <!-- --------------------------------------------------- sidebar -->
      <aside class="lg:col-span-2">
        <div class="card card-muted">
          <h2 class="text-lg">Prefer to skip the form?</h2>
          <ul class="mt-5 space-y-4">
            <li class="flex gap-3">
              <Icon name="mail" size={18} class="mt-1 shrink-0 text-brand-600" />
              <div>
                <span class="block text-sm text-ink-500">Email</span>
                <a
                  href={`mailto:${SITE.email}`}
                  class="text-ink-800 no-underline hover:text-brand-700 hover:underline"
                >
                  {SITE.email}
                </a>
              </div>
            </li>
            <li class="flex gap-3">
              <Icon name="arrow-up-right" size={18} class="mt-1 shrink-0 text-brand-600" />
              <div>
                <span class="block text-sm text-ink-500">WhatsApp</span>
                <a
                  href={`https://wa.me/${SITE.whatsapp}`}
                  rel="noopener"
                  class="text-ink-800 no-underline hover:text-brand-700 hover:underline"
                >
                  {SITE.phone}
                </a>
              </div>
            </li>
          </ul>
        </div>

        <div class="card mt-5">
          <h2 class="text-lg">Already have a website?</h2>
          <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
            Get a free report on its speed and performance.
          </p>
          <a href="/analyze" class="btn btn-secondary mt-5">Analyze your site</a>
        </div>
      </aside>
    </div>
  </div>

  <!-- Applies the ?ref=/?site= handoff from the analyzer. Do not remove. -->
  <script is:inline>
    (function () {
      var p = new URLSearchParams(location.search);
      var site = p.get('site');
      if (site) {
        var field = document.getElementById('website');
        if (field && !field.value) field.value = site;
      }
      if (p.get('ref') === 'analyzer') {
        var note = document.getElementById('analyzer-note');
        if (note) note.hidden = false;
        var src = document.getElementById('lead-source');
        if (src) src.value = 'analyzer';
      }
    })();
  </script>

  <!-- Sends the form in the background so visitors stay on this site. -->
  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var btn = document.getElementById('submit-btn');
      var errorMsg = document.getElementById('form-error');
      var success = document.getElementById('form-success');
      var note = document.getElementById('analyzer-note');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorMsg.hidden = true;
        btn.disabled = true;
        btn.textContent = 'Sending...';

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Send failed');
            form.hidden = true;
            if (note) note.hidden = true;
            success.hidden = false;
            success.scrollIntoView({ behavior: 'smooth', block: 'center' });
          })
          .catch(function () {
            errorMsg.hidden = false;
            btn.disabled = false;
            btn.textContent = 'Send message';
          });
      });
    })();
  </script>
</PageLayout>