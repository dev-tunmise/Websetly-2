---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CTASection from '../components/CTASection.astro';
import { TIERS, BUILD_PRICING, PRICING_FAQ } from '../data/pricing';
import { SITE } from '../consts';

const title = 'Pricing';
const description =
  'The audit is free. Everything else is priced after it, because the size of the job is not knowable until something has been measured.';

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/pricing#faq`,
  mainEntity: PRICING_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<PageLayout
  title={title}
  description={description}
  heading="Pricing"
  lede="The audit is free. Everything after it is quoted once we know what your site actually needs — which is the only way a number means anything."
  eyebrow="What it costs"
  breadcrumbs={[{ name: 'Pricing', href: '/pricing' }]}
  schemaEntities={[faqSchema]}
>
  <div class="container-page py-12 sm:py-16">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        TIERS.map((t) => (
          <article
            class:list={[
              'card flex flex-col',
              t.featured && 'border-brand-300 ring-1 ring-brand-200',
            ]}
          >
            {t.featured && (
              <span class="pill pill-brand mb-4 self-start">Most common</span>
            )}

            <h2 class="text-xl">{t.name}</h2>
            <p class="mt-2 text-[0.9375rem] text-ink-600">{t.tagline}</p>

            <p class="mt-6">
              {t.price ? (
                <>
                  <span class="text-3xl font-semibold text-ink-900">{t.price}</span>
                  {t.cadence && (
                    <span class="ml-1.5 text-sm text-ink-500">{t.cadence}</span>
                  )}
                </>
              ) : (
                <span class="text-lg font-medium text-ink-800">
                  Priced after your audit
                </span>
              )}
            </p>

            <p class="mt-4 text-sm leading-relaxed text-ink-500">
              <span class="font-medium text-ink-700">Best for:</span> {t.bestFor}
            </p>

            <ul class="mt-6 flex-1 space-y-2.5">
              {t.features.map((f) => (
                <li class="flex gap-2.5 text-[0.9375rem] text-ink-700">
                  <Icon name="check" size={17} class="mt-1 shrink-0 text-brand-600" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a
              href={t.cta.href}
              class:list={[
                'mt-8',
                t.featured ? 'btn btn-primary' : 'btn btn-secondary',
              ]}
            >
              {t.cta.label}
            </a>
          </article>
        ))
      }
    </div>

    <!-- Secondary offer, visually secondary. -->
    <div class="card card-muted mt-6 sm:flex sm:items-center sm:justify-between sm:gap-8">
      <div>
        <h2 class="text-lg">{BUILD_PRICING.name}</h2>
        <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-600">
          {BUILD_PRICING.note}
        </p>
      </div>
      <a href={BUILD_PRICING.href} class="btn btn-secondary mt-5 shrink-0 sm:mt-0">
        About new builds
      </a>
    </div>
  </div>

  <Section title="Questions about pricing" tone="muted">
    <div class="container-prose mx-0">
      {
        PRICING_FAQ.map((f) => (
          <details class="group border-b border-ink-200 py-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg font-medium text-ink-900 marker:content-none [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon
                name="chevron-down"
                size={20}
                class="shrink-0 text-ink-400 transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 max-w-2xl leading-relaxed text-ink-600">{f.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <CTASection source="pricing-closing" />
</PageLayout>
