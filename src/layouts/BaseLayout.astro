---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  schemaEntities?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
  /** Pages that need the analyzer opt in; nothing else loads it. */
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  canonical,
  noindex,
  publishedTime,
  modifiedTime,
  author,
  schemaEntities = [],
  breadcrumbs,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- The font is same-origin and preloaded, so text paints once with the
         right face. No third-party connection is needed at all, which removes
         the two preconnects and the render-blocking stylesheet the legacy site
         used on every page. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} Blog`}
      href="/rss.xml"
    />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      canonical={canonical}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
    />
    <Schema entities={schemaEntities} breadcrumbs={breadcrumbs} />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!--
      Analytics is deferred until the page has finished loading so it cannot
      compete with LCP or add to INP. The legacy site injected gtag during head
      parsing on every page.
      GA4 property is unchanged (G-YN57XMWHS1) so historical data stays intact.
    -->
    <script is:inline define:vars={{ gaId: SITE.ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { send_page_view: true });

      function loadAnalytics() {
        if (window.__ga_loaded) return;
        window.__ga_loaded = true;
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        s.async = true;
        document.head.appendChild(s);
      }

      if (document.readyState === 'complete') {
        requestIdleCallback ? requestIdleCallback(loadAnalytics) : setTimeout(loadAnalytics, 1200);
      } else {
        addEventListener(
          'load',
          function () {
            typeof requestIdleCallback === 'function'
              ? requestIdleCallback(loadAnalytics)
              : setTimeout(loadAnalytics, 1200);
          },
          { once: true },
        );
      }
    </script>
  </body>
</html>
