# Cloudflare Pages headers.
#
# The audit of the live site found every response served with
#   Cache-Control: public, max-age=0, must-revalidate
# and cf-cache-status: DYNAMIC — i.e. nothing was being cached at the edge, on a
# site that is entirely static. This file fixes that, which is the single
# cheapest performance win available.

/*
  # Sensible defaults. HTML is revalidated but may be served stale while it is,
  # so a repeat visitor never waits on the origin.
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Astro fingerprints these filenames, so the content at a given URL can never
# change. Cache them for a year and never revalidate.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# Feeds and sitemaps change with each publish; an hour is plenty.
/rss.xml
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-*.xml
  Cache-Control: public, max-age=3600
